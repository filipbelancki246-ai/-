      theme: 'light',
      cart: {},      // id -> qty
      user: null,    // {name, email}
      checkoutStep: 0,
      checkoutDetails: {}
    };


    /* ===== Owner Admin ===== */
    var ADMIN_PASSWORD = 'CHANGE-ME-2026';
    var adminLoggedIn = false;

    function saveFoodItems(){
      try{ localStorage.setItem('sd_food_items', JSON.stringify(FOOD_ITEMS)); }catch(e){}
    }
    function makeFoodId(){
      return 'custom_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,7);
    }
    function adminFoodName(item){
      return item.customName || (T[state.lang] && T[state.lang][item.key]) || item.key || item.id;
    }
    function renderAdminFoodList(){
      var list = document.getElementById('admin-food-list');
      if(!list) return;
      list.innerHTML = '';
      FOOD_ITEMS.forEach(function(item){
        var row = document.createElement('div');
        row.className = 'admin-food';
        row.innerHTML = '<img alt=""><div class="meta"><div class="name"></div><div class="price"></div></div><button class="admin-delete" type="button">Удалить</button>';
        row.querySelector('img').src = item.img;
        row.querySelector('img').setAttribute('data-kor', item.kor || '');
        row.querySelector('img').onerror = function(){ window.__sdFallback(this); };
        row.querySelector('.name').textContent = adminFoodName(item);
        row.querySelector('.price').textContent = formatPrice(item.price);
        row.querySelector('.admin-delete').addEventListener('click', function(){
          if(!confirm('Удалить это блюдо из меню?')) return;
          FOOD_ITEMS = FOOD_ITEMS.filter(function(f){ return f.id !== item.id; });
          delete state.cart[item.id];
          saveFoodItems(); saveCart();
          renderFoodGrid(); renderCart(); updateCartBadge(); renderAdminFoodList();
          showToast('Блюдо удалено');
        });
        list.appendChild(row);
      });
    }
    function openAdmin(){
      var p = document.getElementById('admin-panel');
      p.classList.add('show'); p.setAttribute('aria-hidden','false');
      document.getElementById('admin-error').textContent = '';
      document.getElementById('admin-login-card').style.display = adminLoggedIn ? 'none' : 'block';
      document.getElementById('admin-content').style.display = adminLoggedIn ? 'block' : 'none';
      if(adminLoggedIn) renderAdminFoodList();
    }
    function closeAdmin(){
      var p = document.getElementById('admin-panel');
      p.classList.remove('show'); p.setAttribute('aria-hidden','true');
    }
    document.getElementById('admin-fab').addEventListener('click', openAdmin);
    document.getElementById('admin-close').addEventListener('click', closeAdmin);
    document.getElementById('admin-login-btn').addEventListener('click', function(){
      var err = document.getElementById('admin-error');
      if(document.getElementById('admin-password').value !== ADMIN_PASSWORD){
        err.textContent = 'Неверный пароль'; return;
      }
      adminLoggedIn = true;
      document.getElementById('admin-fab').classList.add('show');
      openAdmin();
      showToast('Добро пожаловать в админ-панель');
    });
    document.getElementById('admin-password').addEventListener('keydown', function(e){
      if(e.key === 'Enter') document.getElementById('admin-login-btn').click();
    });
    document.getElementById('admin-food-form').addEventListener('submit', function(e){
      e.preventDefault();
      if(!adminLoggedIn) return;
      var name = document.getElementById('admin-name').value.trim();
      var kor = document.getElementById('admin-kor').value.trim() || name;
      var price = Number(document.getElementById('admin-price').value);
      var img = document.getElementById('admin-img').value.trim();
      if(!name || !Number.isFinite(price) || price < 0 || !img) return;
      FOOD_ITEMS.push({id:makeFoodId(), kor:kor, key:'custom_food', customName:name, price:price, img:img});
      saveFoodItems(); renderFoodGrid(); renderCart(); renderAdminFoodList();
      e.target.reset(); showToast('Блюдо добавлено в меню');
    });
    document.addEventListener('keydown', function(e){
      if(e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'a'){ e.preventDefault(); openAdmin(); }
    });

    function loadState(){
      try{
        var lang = localStorage.getItem('sd_lang');
        if(lang && T[lang]) state.lang = lang;
        else {
          var nav = (navigator.language || 'ru').slice(0,2).toLowerCase();
          state.lang = T[nav] ? nav : 'ru';
        }
      }catch(e){}
      try{ state.theme = localStorage.getItem('sd_theme') || 'light'; }catch(e){}
      try{ state.cart = JSON.parse(localStorage.getItem('sd_cart') || '{}'); }catch(e){ state.cart = {}; }
      try{
        var email = localStorage.getItem('sd_current_user');
        if(email){
          var users = getUsers();
          var u = users.find(function(x){ return x.email === email; });
          if(u) state.user = { name:u.name, email:u.email };
        }
      }catch(e){}
    }
    function saveCart(){ try{ localStorage.setItem('sd_cart', JSON.stringify(state.cart)); }catch(e){} }
    function getUsers(){ try{ return JSON.parse(localStorage.getItem('sd_users') || '[]'); }catch(e){ return []; } }
    function saveUsers(list){ try{ localStorage.setItem('sd_users', JSON.stringify(list)); }catch(e){} }
    function saveOrder(order){
      try{
        var key = 'sd_orders_' + (state.user ? state.user.email : 'guest');
        var list = JSON.parse(localStorage.getItem(key) || '[]');
        list.push(order);
        localStorage.setItem(key, JSON.stringify(list));
      }catch(e){}
    }

    /* ---------------- i18n apply ---------------- */
    function tr(key){ return (T[state.lang] && T[state.lang][key]) || T.en[key] || key; }

    function applyLanguage(){
      document.documentElement.setAttribute('lang', state.lang);
      var dict = T[state.lang];
      document.querySelectorAll('[data-i18n]').forEach(function(el){
        var k = el.getAttribute('data-i18n');
        if(dict[k] !== undefined){
          el.style.transition = 'opacity .2s ease';
          el.style.opacity = 0;
          setTimeout(function(){ el.textContent = dict[k]; el.style.opacity = 1; }, 120);
        }
      });
      renderFoodGrid();
      renderCart();
      buildLangGrid();
      try{ localStorage.setItem('sd_lang', state.lang); }catch(e){}
    }

    window.__sdFallback = function(imgEl){
      imgEl.onerror = null;
      var kor = imgEl.getAttribute('data-kor') || '';
      var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="600" height="460">' +
        '<rect width="100%" height="100%" fill="#7f9a4f"/>' +
        '<text x="50%" y="50%" font-family="Georgia,serif" font-size="34" fill="#ffffff" text-anchor="middle" dominant-baseline="middle">' + kor + '</text></svg>';
      imgEl.src = 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
    };

    function formatPrice(n){
      var locale = LOCALE_TAG[state.lang] || 'en-US';
      try{ return Number(n).toLocaleString(locale) + ' ₩'; }
      catch(e){ return n + ' ₩'; }
    }

    /* ---------------- Theme ---------------- */
    function applyTheme(){
      if(state.theme === 'dark'){
        document.body.setAttribute('data-theme','dark');
      } else {
        document.body.removeAttribute('data-theme');
      }
      var toggle = document.getElementById('theme-toggle');
      var label = document.getElementById('theme-state-label');
      if(toggle) toggle.classList.toggle('on', state.theme === 'dark');
      if(label) label.textContent = state.theme === 'dark' ? tr('settings_theme_dark') : tr('settings_theme_light');
      try{ localStorage.setItem('sd_theme', state.theme); }catch(e){}
    }

    /* ---------------- Toasts ---------------- */
    function showToast(message){
      var stack = document.getElementById('toast-stack');
      var el = document.createElement('div');
      el.className = 'toast';
      el.innerHTML = '<span class="dot"></span><span></span>';
      el.querySelector('span:last-child').textContent = message;
      stack.appendChild(el);
      requestAnimationFrame(function(){ el.classList.add('show'); });
      setTimeout(function(){
        el.classList.remove('show');
        setTimeout(function(){ el.remove(); }, 400);
      }, 2800);
    }

    /* ---------------- Modal / overlay helpers ---------------- */
    var overlay = document.getElementById('overlay');
    var openStack = [];

    function openPanel(id){
      var el = document.getElementById(id);
      if(!el) return;
      el.classList.add('show');
      el.setAttribute('aria-hidden','false');
      overlay.classList.add('show');
      openStack.push(id);
    }
    function closePanel(id){
      var el = document.getElementById(id);
      if(!el) return;
      el.classList.remove('show');
      el.setAttribute('aria-hidden','true');
      openStack = openStack.filter(function(x){ return x !== id; });
      if(openStack.length === 0) overlay.classList.remove('show');
    }
    function closeAllPanels(){
      openStack.slice().forEach(closePanel);
    }
    overlay.addEventListener('click', closeAllPanels);
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape') closeAllPanels();
    });
    document.querySelectorAll('[data-close-modal]').forEach(function(btn){
      btn.addEventListener('click', function(){ closePanel(btn.getAttribute('data-close-modal')); });
    });

    /* ---------------- Food grid ---------------- */
    var revealObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('in-view');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold:0.15 });

    function renderFoodGrid(){
      var grid = document.getElementById('food-grid');
      grid.innerHTML = '';
      FOOD_ITEMS.forEach(function(item, idx){
        var fig = document.createElement('figure');
        fig.className = 'food';
        fig.style.transitionDelay = (idx * 60) + 'ms';
        fig.innerHTML =
          '<div class="imgwrap" data-open-lightbox="'+item.id+'">' +
            '<img data-kor="'+item.kor+'" src="'+item.img+'" alt="'+tr(item.key)+'" loading="lazy" onerror="window.__sdFallback(this)">' +
          '</div>' +
          '<figcaption>' +
            '<span class="en">'+tr(item.key)+'</span>' +
            '<span class="korean">'+item.kor+'</span>' +
            '<div class="price-row">' +
              '<span class="price">'+formatPrice(item.price)+'</span>' +
              '<button class="add-btn" data-add="'+item.id+'">' +
                '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>' +
                '<span>'+tr('add_to_cart')+'</span>' +
              '</button>' +
            '</div>' +
          '</figcaption>';
        grid.appendChild(fig);
        revealObserver.observe(fig);
      });

      grid.querySelectorAll('[data-open-lightbox]').forEach(function(el){
        el.addEventListener('click', function(){
          var item = FOOD_ITEMS.find(function(f){ return f.id === el.getAttribute('data-open-lightbox'); });
          openLightbox(item);
        });
      });
      grid.querySelectorAll('[data-add]').forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.stopPropagation();
          addToCart(btn.getAttribute('data-add'), btn);
        });
      });
    }

    /* ---------------- Lightbox ---------------- */
    var lightbox = document.getElementById('lightbox');
    var lbImg = document.getElementById('lb-img');
    var lbEn = document.getElementById('lb-en');
    var lbKor = document.getElementById('lb-kor');
    function openLightbox(item){
      lbImg.setAttribute('data-kor', item.kor);
      lbImg.onerror = function(){ window.__sdFallback(lbImg); };
      lbImg.src = item.img;
      lbImg.alt = tr(item.key);
      lbEn.textContent = tr(item.key);
      lbKor.textContent = item.kor;
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden','false');
    }
    function closeLightbox(){
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden','true');
    }
    document.getElementById('lb-close').addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', function(e){ if(e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeLightbox(); });

    /* ---------------- Cart ---------------- */
    function cartCount(){
      return Object.keys(state.cart).reduce(function(sum,id){ return sum + state.cart[id]; }, 0);
    }
    function cartTotal(){
      return Object.keys(state.cart).reduce(function(sum,id){
        var item = FOOD_ITEMS.find(function(f){ return f.id === id; });
        return sum + (item ? item.price * state.cart[id] : 0);
      }, 0);
    }
    function updateCartBadge(){
      var badge = document.getElementById('cart-badge');
      var count = cartCount();
      badge.textContent = count;
      badge.classList.toggle('show', count > 0);
      badge.classList.remove('bump');
      void badge.offsetWidth;
      badge.classList.add('bump');
    }

    function addToCart(id, sourceBtn){
      state.cart[id] = (state.cart[id] || 0) + 1;
      saveCart();
      updateCartBadge();
      renderCart();
      showToast(tr('toast_added'));
      if(sourceBtn) flyToCart(sourceBtn);
    }
    function changeQty(id, delta){
      if(!state.cart[id]) return;
      state.cart[id] += delta;
      if(state.cart[id] <= 0) delete state.cart[id];
      saveCart();
      updateCartBadge();
      renderCart();
    }
    function removeFromCart(id){
      delete state.cart[id];
      saveCart();
      updateCartBadge();
      renderCart();
    }

    function flyToCart(sourceBtn){
      var cartBtn = document.getElementById('btn-cart');
      var imgEl = sourceBtn.closest('.food').querySelector('img');
      var srcRect = imgEl.getBoundingClientRect();
      var dstRect = cartBtn.getBoundingClientRect();
      var clone = imgEl.cloneNode();
      clone.className = 'fly-thumb';
      clone.style.left = srcRect.left + 'px';
      clone.style.top = srcRect.top + 'px';
      clone.style.width = srcRect.width + 'px';
      clone.style.height = srcRect.height + 'px';
      clone.style.opacity = '0.95';
      document.body.appendChild(clone);
      requestAnimationFrame(function(){
        clone.style.left = (dstRect.left + dstRect.width/2 - 10) + 'px';
        clone.style.top = (dstRect.top + dstRect.height/2 - 10) + 'px';
        clone.style.width = '20px';
        clone.style.height = '20px';
        clone.style.opacity = '0.2';
      });
      setTimeout(function(){ clone.remove(); }, 750);
    }

    function renderCart(){
      var body = document.getElementById('cart-body');
      var foot = document.getElementById('cart-foot');
      var ids = Object.keys(state.cart);
      if(ids.length === 0){
        body.innerHTML = '<div class="cart-empty">'+tr('cart_empty')+'</div>';
        foot.style.display = 'none';
        return;
      }
      foot.style.display = 'block';
      body.innerHTML = '';
      ids.forEach(function(id){
        var item = FOOD_ITEMS.find(function(f){ return f.id === id; });
        if(!item) return;
        var qty = state.cart[id];
        var row = document.createElement('div');
        row.className = 'cart-item';
        row.innerHTML =
          '<img data-kor="'+item.kor+'" src="'+item.img+'" alt="" onerror="window.__sdFallback(this)">' +
          '<div class="info">' +
            '<div class="name">'+(item.customName || tr(item.key))+'</div>' +
            '<div class="sub">'+formatPrice(item.price)+'</div>' +
            '<div class="qty-row">' +
              '<button class="qty-btn" data-dec="'+id+'">−</button>' +
              '<span>'+qty+'</span>' +
              '<button class="qty-btn" data-inc="'+id+'">+</button>' +
              '<button class="remove-btn" data-remove="'+id+'">✕</button>' +
            '</div>' +
          '</div>' +
          '<div class="linetotal">'+formatPrice(item.price * qty)+'</div>';
        body.appendChild(row);
      });
      document.getElementById('cart-total').textContent = formatPrice(cartTotal());

      body.querySelectorAll('[data-inc]').forEach(function(b){ b.addEventListener('click', function(){ changeQty(b.getAttribute('data-inc'), 1); }); });
      body.querySelectorAll('[data-dec]').forEach(function(b){ b.addEventListener('click', function(){ changeQty(b.getAttribute('data-dec'), -1); }); });
      body.querySelectorAll('[data-remove]').forEach(function(b){ b.addEventListener('click', function(){ removeFromCart(b.getAttribute('data-remove')); }); });
    }

    document.getElementById('btn-cart').addEventListener('click', function(){ openPanel('drawer-cart'); });

    /* ---------------- Auth ---------------- */
    function refreshAuthUI(){
      var out = document.getElementById('auth-logged-out');
      var inn = document.getElementById('auth-logged-in');
      if(state.user){
        out.style.display = 'none';
        inn.style.display = 'block';
        document.getElementById('account-name').textContent = state.user.name;
        document.getElementById('account-email').textContent = state.user.email;
      } else {
        out.style.display = 'block';
        inn.style.display = 'none';
      }
    }

    document.getElementById('btn-account').addEventListener('click', function(){
      refreshAuthUI();
      openPanel('modal-auth');
    });

    document.getElementById('tab-login').addEventListener('click', function(){
      document.getElementById('tab-login').classList.add('active');
      document.getElementById('tab-register').classList.remove('active');
      document.getElementById('form-login').style.display = 'block';
      document.getElementById('form-register').style.display = 'none';
    });
    document.getElementById('tab-register').addEventListener('click', function(){
      document.getElementById('tab-register').classList.add('active');
      document.getElementById('tab-login').classList.remove('active');
      document.getElementById('form-register').style.display = 'block';
      document.getElementById('form-login').style.display = 'none';
    });

    function simpleHash(str){
      var h = 0;
      for(var i=0;i<str.length;i++){ h = ((h<<5)-h) + str.charCodeAt(i); h |= 0; }
      return String(h);
    }

    document.getElementById('form-login').addEventListener('submit', function(e){
      e.preventDefault();
      var email = document.getElementById('login-email').value.trim().toLowerCase();
      var pass = document.getElementById('login-password').value;
      var users = getUsers();
      var u = users.find(function(x){ return x.email === email && x.pass === simpleHash(pass); });
      var err = document.getElementById('login-error');
      if(!u){ err.textContent = tr('err_login_fail'); return; }
      err.textContent = '';
      state.user = { name:u.name, email:u.email };
      try{ localStorage.setItem('sd_current_user', u.email); }catch(ex){}
      refreshAuthUI();
      showToast(tr('toast_welcome_back'));
      e.target.reset();
    });

    document.getElementById('form-register').addEventListener('submit', function(e){
      e.preventDefault();
      var name = document.getElementById('reg-name').value.trim();
      var email = document.getElementById('reg-email').value.trim().toLowerCase();
      var pass = document.getElementById('reg-password').value;
      var confirm = document.getElementById('reg-confirm').value;
      var err = document.getElementById('register-error');
      var users = getUsers();
      if(pass !== confirm){ err.textContent = tr('err_reg_mismatch'); return; }
      if(users.some(function(x){ return x.email === email; })){ err.textContent = tr('err_reg_exists'); return; }
      err.textContent = '';
      users.push({ name:name, email:email, pass:simpleHash(pass) });
      saveUsers(users);
      state.user = { name:name, email:email };
      try{ localStorage.setItem('sd_current_user', email); }catch(ex){}
      refreshAuthUI();
      showToast(tr('toast_account_created'));
      e.target.reset();
    });

    document.getElementById('btn-logout').addEventListener('click', function(){
      state.user = null;
      try{ localStorage.removeItem('sd_current_user'); }catch(e){}
      refreshAuthUI();
      showToast(tr('toast_logged_out'));
      closePanel('modal-auth');
    });

    /* ---------------- Checkout ---------------- */
    function goCheckoutStep(step){
      state.checkoutStep = step;
      document.querySelectorAll('.co-step').forEach(function(p){
        p.style.display = (parseInt(p.getAttribute('data-step-panel'),10) === step) ? 'block' : 'none';
      });
      document.querySelectorAll('.checkout-steps-nav span').forEach(function(s,i){
        s.classList.toggle('active', i <= step);
      });
      if(step === 0) renderCheckoutSummary();
    }

    function renderCheckoutSummary(){
      var el = document.getElementById('co-summary');
      var ids = Object.keys(state.cart);
      var html = '';
      ids.forEach(function(id){
        var item = FOOD_ITEMS.find(function(f){ return f.id === id; });
        if(!item) return;
        html += '<div class="co-summary-row"><span>'+(item.customName || tr(item.key))+' × '+state.cart[id]+'</span><span>'+formatPrice(item.price*state.cart[id])+'</span></div>';
      });
      html += '<div class="co-summary-total"><span>'+tr('cart_subtotal')+'</span><span>'+formatPrice(cartTotal())+'</span></div>';
      el.innerHTML = html;
    }

    document.getElementById('btn-checkout').addEventListener('click', function(){
      if(cartCount() === 0) return;
      closePanel('drawer-cart');
      goCheckoutStep(0);
      if(state.user) document.getElementById('co-name').value = state.user.name;
      openPanel('modal-checkout');
    });

    document.getElementById('co-next-0').addEventListener('click', function(){ goCheckoutStep(1); });
    document.getElementById('co-back-1').addEventListener('click', function(){ goCheckoutStep(0); });
    document.getElementById('co-back-2').addEventListener('click', function(){ goCheckoutStep(1); });

    document.getElementById('form-checkout-details').addEventListener('submit', function(e){
      e.preventDefault();
      state.checkoutDetails = {
        name: document.getElementById('co-name').value.trim(),
        address: document.getElementById('co-address').value.trim(),
        phone: document.getElementById('co-phone').value.trim()
      };
      goCheckoutStep(2);
    });

    document.getElementById('co-card').addEventListener('input', function(e){
      var digits = e.target.value.replace(/\D/g,'').slice(0,16);
      e.target.value = digits.replace(/(.{4})/g,'$1 ').trim();
    });
    document.getElementById('co-expiry').addEventListener('input', function(e){
      var digits = e.target.value.replace(/\D/g,'').slice(0,4);
      if(digits.length >= 3) e.target.value = digits.slice(0,2) + '/' + digits.slice(2);
      else e.target.value = digits;
    });
    document.getElementById('co-cvc').addEventListener('input', function(e){
      e.target.value = e.target.value.replace(/\D/g,'').slice(0,3);
    });

    document.getElementById('form-checkout-payment').addEventListener('submit', function(e){
      e.preventDefault();
      var card = document.getElementById('co-card').value.replace(/\s/g,'');
      var expiry = document.getElementById('co-expiry').value;
      var cvc = document.getElementById('co-cvc').value;
      var err = document.getElementById('checkout-error');

      if(card.length !== 16){ err.textContent = tr('err_card'); return; }
      var m = expiry.match(/^(\d{2})\/(\d{2})$/);
      if(!m || parseInt(m[1],10) < 1 || parseInt(m[1],10) > 12){ err.textContent = tr('err_expiry'); return; }
      if(cvc.length !== 3){ err.textContent = tr('err_cvc'); return; }
      err.textContent = '';

      var orderNumber = 'SD-' + Date.now().toString().slice(-8);
      var order = {
        number: orderNumber,
        date: new Date().toISOString(),
        items: Object.keys(state.cart).map(function(id){
          var item = FOOD_ITEMS.find(function(f){ return f.id === id; });
          return { id:id, qty:state.cart[id], price:item ? item.price : 0 };
        }),
        total: cartTotal(),
        details: state.checkoutDetails
      };
      saveOrder(order);
      document.getElementById('order-number').textContent = tr('checkout_order_prefix') + ' ' + orderNumber;

      state.cart = {};
      saveCart();
      updateCartBadge();
      renderCart();

      goCheckoutStep(3);
      var svgCircle = document.querySelector('.success-check circle');
      var svgPath = document.querySelector('.success-check path');
      [svgCircle, svgPath].forEach(function(elm){
        if(!elm) return;
        elm.style.animation = 'none';
        void elm.offsetWidth;
        elm.style.animation = '';
      });
      e.target.reset();
    });

    document.getElementById('co-finish').addEventListener('click', function(){
      closePanel('modal-checkout');
      goCheckoutStep(0);
    });

    /* ---------------- Settings: language + theme ---------------- */
    function buildLangGrid(){
      var grid = document.getElementById('lang-grid');
      grid.innerHTML = '';
      Object.keys(LANG_META).forEach(function(code){
        var opt = document.createElement('button');
        opt.type = 'button';
        opt.className = 'lang-opt' + (state.lang === code ? ' active' : '');
        opt.innerHTML = '<span class="flag">'+LANG_META[code].flag+'</span><span>'+LANG_META[code].label+'</span>';
        opt.addEventListener('click', function(){
          state.lang = code;
          applyLanguage();
          applyTheme();
        });
        grid.appendChild(opt);
      });
    }
    document.getElementById('theme-toggle').addEventListener('click', function(){
      state.theme = state.theme === 'dark' ? 'light' : 'dark';
      applyTheme();
    });
    document.getElementById('btn-settings').addEventListener('click', function(){ openPanel('modal-settings'); });
    document.getElementById('btn-lang').addEventListener('click', function(){ openPanel('modal-settings'); });

    /* ---------------- Nav misc ---------------- */
    document.getElementById('logo-home').addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });
    document.getElementById('nav-event').addEventListener('click', function(e){ e.preventDefault(); showToast(tr('toast_no_events')); });
    document.getElementById('nav-support').addEventListener('click', function(e){ e.preventDefault(); showToast(tr('toast_support')); });
    document.getElementById('nav-event-m').addEventListener('click', function(e){ e.preventDefault(); showToast(tr('toast_no_events')); closeMobileMenu(); });
    document.getElementById('nav-support-m').addEventListener('click', function(e){ e.preventDefault(); showToast(tr('toast_support')); closeMobileMenu(); });
    document.querySelector('.contact-btn').addEventListener('click', function(){ showToast(tr('toast_support')); });
    document.getElementById('franchise-cta').addEventListener('click', function(e){ e.preventDefault(); });

    var mobileMenu = document.getElementById('mobile-menu');
    function openMobileMenu(){ mobileMenu.classList.add('show'); }
    function closeMobileMenu(){ mobileMenu.classList.remove('show'); }
    document.getElementById('btn-hamburger').addEventListener('click', openMobileMenu);
    document.getElementById('mobile-close').addEventListener('click', closeMobileMenu);
    mobileMenu.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){ closeMobileMenu(); });
    });

    /* ---------------- Franchise step scroll reveal ---------------- */
    var stepObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry, i){
        if(entry.isIntersecting){
          entry.target.style.transitionDelay = (i * 80) + 'ms';
          entry.target.classList.add('in-view');
          stepObserver.unobserve(entry.target);
        }
      });
    }, { threshold:0.2 });
    document.querySelectorAll('.step').forEach(function(el){ stepObserver.observe(el); });

    /* ---------------- Init ---------------- */
    loadState();
    saveFoodItems();
    applyLanguage();
    applyTheme();
    updateCartBadge();
    refreshAuthUI();

  })();
  </script>
</body>
</html>
